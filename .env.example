# Copie para .env na raiz do repositório e preencha com os valores da SUA máquina:
#
#     cp .env.example .env && ${EDITOR:-nano} .env
#
# Os três stacks leem este mesmo arquivo através de symlinks já versionados
# (docker/jellyfin/.env -> ../../.env, e assim por diante). Não crie um .env
# por stack: eles divergem em silêncio.
#
# Toda variável abaixo é obrigatória. Os compose usam a sintaxe ${VAR:?...},
# então um valor faltando aborta com mensagem clara em vez de gerar uma
# montagem vazia do tipo ":/media:ro".

# --- identidade e permissões ---
# Dono dos arquivos de mídia. Descubra com: id -u  e  id -g
PUID=1000
PGID=1000
# Fuso de todos os containers. Lista: timedatectl list-timezones
TZ=America/Sao_Paulo

# --- caminhos do host ---
# Raiz da mídia. O Jellyfin monta como /media somente leitura.
MEDIA_ROOT=/mnt/dados
# Subárvore que Radarr/Sonarr/Bazarr/qBittorrent veem como /data.
# Precisa estar no MESMO sistema de arquivos que MEDIA_ROOT para o import
# por hardlink funcionar — é isso que evita duplicar cada arquivo.
VIDEO_ROOT=/mnt/dados/Videos
# Downloads em andamento. Aponte para um disco RÁPIDO para escrita aleatória
# (ext4 local), não para o disco da biblioteca. Ver docs/00-arquitetura.md.
DOWNLOADS_INCOMPLETE=/home/jonatan/downloads-incompletos

# --- rede e domínio ---
# IP fixo do servidor na LAN. Descubra com: ip -4 addr show
LAN_IP=192.168.1.10
# IP do Tailscale. Descubra com: tailscale ip -4
TS_IP=100.64.0.1
# Nome MagicDNS desta máquina: tailscale status --json | jq -r .Self.DNSName
TS_HOSTNAME=minha-maquina.minha-tailnet.ts.net
# TLD interno resolvido por AdGuard + Nginx Proxy Manager. Escolha um que NÃO
# exista de verdade (.casa e .lan são TLDs reais e causam vazamento de consulta).
INTERNAL_DOMAIN=jts

# --- hardware (VAAPI / transcodificação por GPU) ---
# Nodo de render. Se sua máquina não tem GPU utilizável, remova o bloco
# "devices:" do docker/jellyfin/docker-compose.yml em vez de apagar a variável.
DRI_DEVICE=/dev/dri
# ATENÇÃO: estes GIDs variam por distribuição. Descubra os seus com:
#   getent group render | cut -d: -f3
#   getent group video  | cut -d: -f3
RENDER_GID=992
VIDEO_GID=44

# --- emulação (RomM) ---
# Pasta da biblioteca de ROMs. Estrutura interna esperada, dentro dela:
# roms/<slug-da-plataforma>/arquivo (ex.: roms/snes, roms/gba). Ver
# docs/01-instalacao.md.
ROMS_ROOT=/mnt/dados/ROMs

# Gere com: openssl rand -hex 16
ROMM_DB_PASSWORD=
# Gere com: openssl rand -hex 16 (pode repetir o valor acima, mas prefira outro)
ROMM_DB_ROOT_PASSWORD=
# Gere com: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# Opcionais — deixe em branco se não for usar o provedor. Cada um exige conta
# própria; ver docs/01-instalacao.md para onde criar.
ROMM_SCREENSCRAPER_USER=
ROMM_SCREENSCRAPER_PASSWORD=
ROMM_RETROACHIEVEMENTS_API_KEY=
ROMM_STEAMGRIDDB_API_KEY=

# --- portas ---
# Só as que costumam colidir estão parametrizadas. As demais (7878 Radarr,
# 8989 Sonarr, 6767 Bazarr, 9696 Prowlarr, 5055 Seerr, 8096 Jellyfin) estão
# literais nos compose — mude lá se precisar.
# 3000 fica com o AdGuard, por isso o Homepage usa 3001 no host.
HOMEPAGE_PORT=3001
QBT_WEBUI_PORT=8080

# --- credenciais lidas pelo Homepage ---
# O Homepage resolve {{HOMEPAGE_VAR_X}} dentro de config/services.yaml a partir
# do ambiente do container. Se uma variável faltar, o painel renderiza o texto
# literal "{{...}}" e o widget falha EM SILÊNCIO — confira os cards depois de
# mexer aqui.
#
# Estes dois repetem LAN_IP e TS_HOSTNAME de propósito: o Homepage só enxerga
# variáveis com o prefixo HOMEPAGE_VAR_.
HOMEPAGE_VAR_LAN_IP=192.168.1.10
HOMEPAGE_VAR_TS_HOSTNAME=minha-maquina.minha-tailnet.ts.net

# Cada API key sai da interface do próprio serviço, em Settings -> General:
HOMEPAGE_VAR_JELLYFIN_KEY=     # Jellyfin: Painel -> Chaves de API
HOMEPAGE_VAR_SEERR_KEY=        # Seerr: Configurações -> Geral
HOMEPAGE_VAR_RADARR_KEY=       # Radarr: Settings -> General -> API Key
HOMEPAGE_VAR_SONARR_KEY=       # Sonarr: Settings -> General -> API Key
HOMEPAGE_VAR_BAZARR_KEY=       # Bazarr: Settings -> General -> API Key
HOMEPAGE_VAR_PROWLARR_KEY=     # Prowlarr: Settings -> General -> API Key

# Usuário e senha do WebUI. O qBittorrent sorteia uma senha temporária no
# primeiro boot e a imprime no log: docker compose logs qbittorrent
HOMEPAGE_VAR_QBT_USER=
HOMEPAGE_VAR_QBT_PASS=
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
# RomM: Administração -> Client API Tokens -> criar com escopo
# "platforms.read roms.read" (o painel só lê contagens, não precisa de mais)
HOMEPAGE_VAR_ROMM_KEY=
